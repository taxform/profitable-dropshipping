From a7c2f8d8235a4faa24b47a73995a1cb96cd003e0 Mon Sep 17 00:00:00 2001
From: Muse <muse@local>
Date: Wed, 11 Nov 2026 21:23:31 +0000
Subject: [PATCH] Fix Merchant Center feed sale_price and product JSON-LD
 transit times

- merchant-feed.xml: sale_price was the higher compareAt value, which
  Merchant Center rejects (sale_price must be below price). Now the
  feed emits price=compareAt (regular price) and sale_price=selling
  price for discounted items, and no sale_price otherwise.
- merchant-feed.xml: shipping max transit 12 -> 15 days, matching the
  shipping page / homepage FAQ range of 6-15 business days.
- product.html: client-rendered Product JSON-LD hardcoded transit
  6-12 days for every product; now parses p.shipsIn like the edge
  function, so JS-rendered and server-rendered structured data agree.
- tests: regression tests for the feed sale_price rule and transit.
---
 netlify/functions/merchant-feed.ts | 16 +++++++++------
 public/product.html                |  7 ++++++-
 tests/merchant-feed.test.ts        | 33 ++++++++++++++++++++++++++++++
 3 files changed, 49 insertions(+), 7 deletions(-)
 create mode 100644 tests/merchant-feed.test.ts

diff --git a/netlify/functions/merchant-feed.ts b/netlify/functions/merchant-feed.ts
index c47470a..23e4aac 100644
--- a/netlify/functions/merchant-feed.ts
+++ b/netlify/functions/merchant-feed.ts
@@ -16,10 +16,14 @@ export default async () => {
     const price = (p.price / 100).toFixed(2)
     const sale = `https://skabbadeals.com/products/${p.slug}`
     const image = p.image.startsWith('http') ? p.image : `https://skabbadeals.com${p.image}`
-    const salePrice =
-      p.compareAt > p.price
-        ? `    <g:sale_price>${(p.compareAt / 100).toFixed(2)} USD</g:sale_price>`
-        : ''
+    // Google Merchant Center requires sale_price < price. The store's
+    // selling price IS the sale price; compareAt is the regular ("was")
+    // price, so when a product is discounted the feed's price is the
+    // regular price and sale_price is what the shopper actually pays.
+    // (Previously this was backwards: sale_price was the higher compareAt.)
+    const onSale = p.compareAt > p.price
+    const regularPrice = onSale ? (p.compareAt / 100).toFixed(2) : price
+    const salePrice = onSale ? `    <g:sale_price>${price} USD</g:sale_price>` : ''
     return `  <item>
     <g:id>${esc(p.slug)}</g:id>
     <g:title>${esc(`${p.name} — ${p.tagline}`)}</g:title>
@@ -28,7 +32,7 @@ export default async () => {
     <g:image_link>${esc(image)}</g:image_link>
     <g:availability>in_stock</g:availability>
     <g:condition>new</g:condition>
-    <g:price>${price} USD</g:price>
+    <g:price>${regularPrice} USD</g:price>
 ${salePrice}
     <g:brand>Skabba Deals</g:brand>
     <g:mpn>${esc(p.supplier.sku)}</g:mpn>
@@ -42,7 +46,7 @@ ${salePrice}
       <g:min_handling_time>1</g:min_handling_time>
       <g:max_handling_time>2</g:max_handling_time>
       <g:min_transit_time>6</g:min_transit_time>
-      <g:max_transit_time>12</g:max_transit_time>
+      <g:max_transit_time>15</g:max_transit_time>
     </g:shipping>
   </item>`
   }).join('\n')
